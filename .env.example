# URL de base de l'API Laravel v1 de BATIXPRO.
# En production (Docker), pointer sur le réseau interne : http://app:80/api/v1
LARAVEL_API_URL=http://localhost:8000/api/v1

# Port d'écoute du serveur MCP (Streamable HTTP).
PORT=3000

# Niveau de logs : debug | info | warn | error
LOG_LEVEL=info

# Délai max (ms) d'un appel à l'API Laravel avant abandon.
LARAVEL_TIMEOUT_MS=15000

# Noms d'hôte acceptés sur /mcp (protection DNS rebinding), séparés par des virgules,
# port ignoré. Vide = contrôle désactivé (développement local uniquement).
# MCP_ALLOWED_HOSTS=mcp.batixpro.com,batix-mcp,batix_prod_mcp

# Taille maximale d'une requête MCP, en octets (1 Mo par défaut).
# MCP_MAX_BODY_BYTES=1048576

# Variables facultatives lues uniquement par Docker Compose :
# DOCKER_LARAVEL_API_URL=http://host.docker.internal:8000/api/v1
# MCP_BIND_ADDRESS=127.0.0.1
# MCP_PORT=3000
# BATIX_WEB_NETWORK=web
